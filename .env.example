# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required for super-admin account invitations. Server only; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables Gemini-written answers in the product recommendation chat.
# The chat still filters and recommends available products without this key.
# Keep this server-side; do not use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
