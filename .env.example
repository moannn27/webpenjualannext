# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required for super-admin account invitations. Server only; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Chatbot LLM Providers (Server-side only; never use NEXT_PUBLIC_ prefix)
# Primary Provider: Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Failover / Fallback Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Provider order: order in which providers are attempted (e.g. groq,gemini)
LLM_PROVIDER_ORDER=groq,gemini
