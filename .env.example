# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables AI-written answers in the product recommendation chat.
# The chat still filters and recommends available products without this key.
# Keep this server-side; do not use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
